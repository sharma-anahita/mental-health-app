# Server Port
PORT=5000

# MongoDB Connection String
MONGO_URI=your-mongodb-connection-string

# JSON Web Token Secret for Authentication
JWT_SECRET=your-jwt-secret-string

# Allowed Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# Google OAuth Client ID for sign-in functionality
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Groq API Configuration for AI-assisted insights/recommendations
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Upstash Redis REST Credentials for caching/session limits
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# ML Analytics Service Base URL
ML_SERVICE_URL=http://localhost:8000

# Email/SMTP Configuration for notifications and reports
EMAIL_USER=your-email-address
EMAIL_PASSWORD=your-email-app-password
EMAIL_FROM=your-email-address
